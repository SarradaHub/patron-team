# Credenciais de autenticação da aplicação
# A senha NÃO é armazenada em texto puro — apenas o hash SHA-256.
# Para gerar um novo hash, execute: node scripts/generate-hash.js <nova-senha>
VITE_AUTH_USER=admin
VITE_AUTH_PASSWORD_HASH=<hash-sha256-da-senha>

# Supabase (Vercel integration usa NEXT_PUBLIC_*; VITE_* também funciona via envPrefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opcional — aliases Vite (local)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

